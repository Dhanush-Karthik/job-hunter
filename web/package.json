{
  "name": "jobhunter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:real": "npm run build && JOBHUNTER_E2E_REAL=1 playwright test --project=real",
    "typecheck": "tsc -b",
    "dev:mock": "VITE_MOCKS=1 vite"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
