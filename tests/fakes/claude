#!/usr/bin/env python3
"""Offline Claude stream-json protocol; prompts still come from the real Node helper."""

import json
import os
import sys
import time
from pathlib import Path

prompt = sys.argv[sys.argv.index("-p") + 1]
scenario = os.environ.get("JOBHUNTER_FAKE_SCENARIO", "happy")
if scenario == "fail":
    print("Offline Claude: session unavailable", file=sys.stderr)
    raise SystemExit(7)
if scenario == "slow":
    Path(os.environ["JOBHUNTER_FAKE_STARTED"]).touch()
    time.sleep(60)
if "JOBHUNTER SOURCE AND TRANSPORT OVERRIDE" in prompt:
    text = (
        '<<cv-md>>\n# Example Candidate\nJava backend engineer\n<</cv-md>>\n'
        '<<cv-html format="a4">>\n<!DOCTYPE html><html><body>'
        '<h1>Example Candidate</h1><p>Java backend engineer</p></body></html>\n<</cv-html>>'
    )
elif "<<contacts-json>>" in prompt:
    text = '<<contacts-json>>\n' + json.dumps([
        {"name": "Alex Example", "url": "https://example.test/alex",
         "draft": "I build Java services and would like to discuss your backend team."}
    ]) + '\n<</contacts-json>>'
else:
    text = (Path(__file__).resolve().parents[1] / "fixtures/careerops/spike_report.txt").read_text()
print(json.dumps({"type": "result", "result": text, "is_error": False}))
